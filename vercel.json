{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/walker?route=:path*" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/dashboard", "destination": "/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/assignments/:path*", "destination": "/index.html" },
    { "source": "/students/:path*", "destination": "/index.html" },
    { "source": "/results/:path*", "destination": "/index.html" }
  ]
}
